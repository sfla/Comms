<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="connect_form">
    <property name="orientation">vertical</property>
    <property name="margin-bottom">10</property>
    <property name="margin-end">10</property>
    <property name="margin-start">10</property>
    <property name="margin-top">10</property>
    <child>
      <object class="AdwPreferencesGroup">
        <child>
          <object class="AdwEntryRow" id="username_entry">
            <property name="title">username</property>
            <property name="activates-default">1</property>
            <property name="enable-emoji-completion">true</property>
          </object>
        </child>
        <child>
          <object class="AdwEntryRow" id="server_entry">
            <property name="title">server address</property>
            <property name="activates-default">1</property>
            <property name="enable-emoji-completion">true</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="connect_failure_status">
        <property name="justify">center</property>
        <property name="wrap">1</property>
        <property name="margin-top">10</property>
        <property name="label"> </property>
        <attributes>
          <attribute name="foreground" value="#cccc00000000"/>
        </attributes>
      </object>
    </child>
    <child>
      <object class="GtkButton" id="connect_button">
        <property name="css_classes">connect_button</property>
        <property name="focusable">1</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Connect</property>
                <property name="hexpand">1</property>
              </object>
            </child>
            <child>
              <object class="GtkProgressBar" id="connect_progress">
                <property name="opacity">0</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="GtkScrolledWindow" id="user_list_root">
    <property name="focusable">1</property>
    <property name="hscrollbar-policy">never</property>
    <property name="vexpand">1</property>
    <property name="child">
      <object class="GtkListBox" id="user_list">
        <property name="vexpand">1</property>
        <property name="selection-mode">GTK_SELECTION_NONE</property>
      </object>
    </property>
  </object>
</interface>
